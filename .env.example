# AI_GATEWAY_API_KEY: Required for Vercel AI Gateway requests.
# Set this in local .env.local and in your Vercel project environment variables.
AI_GATEWAY_API_KEY="MY_VERCEL_AI_GATEWAY_API_KEY"

# AI_GATEWAY_MODEL: Controls which gateway model this app uses.
# Example value: google/gemini-3-flash
AI_GATEWAY_MODEL="google/gemini-3-flash"

# EMBEDDING_PROVIDER: Which backend to use for knowledge + guidance embeddings.
# Values: openai | gateway
# Default: openai
EMBEDDING_PROVIDER="openai"

# EMBEDDING_GATEWAY_API_KEY: Optional override for embedding requests when EMBEDDING_PROVIDER=gateway.
# If omitted, AI_GATEWAY_API_KEY is used.
EMBEDDING_GATEWAY_API_KEY=""

# EMBEDDING_GATEWAY_BASE_URL: Optional OpenAI-compatible embeddings endpoint base URL.
# Default: https://ai-gateway.vercel.sh/v1
EMBEDDING_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"

# OPENAI_API_KEY: Required for voice transcription, and for embeddings when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_TRANSCRIPTION_MODEL: Optional transcription model override.
# Default: gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"

# KNOWLEDGE_BASE_ENABLED: Set to "false" to disable retrieval from indexed materials.
# Default: true
KNOWLEDGE_BASE_ENABLED="true"

# MATERIALS_DIR: Directory containing Dr. Kristof source materials for indexing.
# Default: ./materials
MATERIALS_DIR="materials"

# KNOWLEDGE_INDEX_DIR: Directory where LlamaIndex persists the vector/doc/index stores.
# Default: ./server/data/knowledge-index
KNOWLEDGE_INDEX_DIR="server/data/knowledge-index"

# KNOWLEDGE_EMBED_MODEL: Embedding model used by LlamaIndex ingestion/retrieval.
# For gateway, provider-prefixed IDs are supported (e.g. openai/text-embedding-3-small).
# Default: text-embedding-3-small
KNOWLEDGE_EMBED_MODEL="text-embedding-3-small"

# KNOWLEDGE_RETRIEVAL_TOP_K: Number of chunks retrieved per turn.
# Default: 4
KNOWLEDGE_RETRIEVAL_TOP_K="4"

# RAG_DEBUG: Set to "true" to include retrieval/guidance debug payload in chat responses.
# Default: false
RAG_DEBUG="false"

# KNOWLEDGE_CHUNK_SIZE: Chunk size used when indexing materials.
# Default: 900
KNOWLEDGE_CHUNK_SIZE="900"

# KNOWLEDGE_CHUNK_OVERLAP: Chunk overlap used when indexing materials.
# Default: 120
KNOWLEDGE_CHUNK_OVERLAP="120"

# GUIDANCE_ENABLED: Set to "false" to disable curated Q/A guidance matching.
# Default: true
GUIDANCE_ENABLED="true"

# GUIDANCE_DATA_PATH: JSON file with curated Q/A guidance entries.
# Default: ./materials/guidance.json
GUIDANCE_DATA_PATH="materials/guidance.json"

# GUIDANCE_EMBED_MODEL: Embedding model for semantic guidance matching.
# For gateway, provider-prefixed IDs are supported (e.g. openai/text-embedding-3-small).
# Default: text-embedding-3-small
GUIDANCE_EMBED_MODEL="text-embedding-3-small"

# GUIDANCE_VERBATIM_THRESHOLD: Minimum match score (0..1) to return a verbatim guidance answer directly.
# Default: 0.90
GUIDANCE_VERBATIM_THRESHOLD="0.90"

# GUIDANCE_ADAPT_THRESHOLD: Minimum match score (0..1) to inject guidance examples into generation.
# Default: 0.78
GUIDANCE_ADAPT_THRESHOLD="0.78"

# GUIDANCE_MATCH_LIMIT: Max number of adapt examples injected per turn.
# Default: 3
GUIDANCE_MATCH_LIMIT="3"

# Private device approvals. Set one browser-generated approval pair per line.
# Leave this empty to deny access until devices are approved.
APP_APPROVED_DEVICES=""
